{
  "expo": {
    "name": "PRIMAL SCAN",
    "slug": "primal-scan",
    "scheme": "primalscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1510",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#0B1510" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.primalscan.app",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.primalscan.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1510",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-camera", { "cameraPermission": "PRIMAL SCAN utilise la caméra pour scanner les codes-barres et les listes d’ingrédients.", "recordAudioAndroid": false }],
      ["expo-image-picker", { "photosPermission": "PRIMAL SCAN accède à vos photos pour ajouter l’image d’une recette ou d’un emballage." }],
      ["expo-splash-screen", { "backgroundColor": "#0B1510", "image": "./assets/splash-icon.png", "imageWidth": 200 }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
